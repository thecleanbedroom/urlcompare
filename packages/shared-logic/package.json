{
  "name": "shared-logic",
  "private": true,
  "version": "0.1.0",
  "description": "Pure, framework-free urlCompare logic: URL checking, crawling, export generation.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "shared-types": "*"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
