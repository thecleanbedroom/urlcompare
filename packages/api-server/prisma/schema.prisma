// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Legacy model — kept until scripts/migrate-legacy.ts has run and a
// follow-up migration drops it. Do not write new code against this.
model CrawlJob {
  id              String    @id @default(cuid())
  name            String?
  sourceDomain    String
  status          String    @default("pending")
  maxPages        Int       @default(500)
  maxDepth        Int       @default(10)
  delayMs         Int       @default(200)
  includePatterns String?
  excludePatterns String?
  discoveredUrls  String?
  totalDiscovered Int       @default(0)
  pagesVisited    Int       @default(0)
  errorCount      Int       @default(0)
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  @@index([status])
  @@index([createdAt])
}

model DiscoveryJob {
  id              String   @id @default(cuid())
  name            String?
  sourceDomain    String
  status          String   @default("pending") // pending, running, completed, failed, cancelled
  sources         String   // JSON array: ["crawl","sitemap","gsc"]
  maxPages        Int      @default(10000)
  maxDepth        Int      @default(20) // up to 1000 via explicit override
  delayMs         Int      @default(200)
  includePatterns String?  // JSON array of glob patterns
  excludePatterns String?  // JSON array of glob patterns
  queryPolicy     String   @default("ignore") // ignore | allow | deny
  queryAllowKeys  String?  // JSON array
  queryDenyKeys   String?  // JSON array
  normalizeQuery  Boolean  @default(true)
  ignoreAnchors   Boolean  @default(true)
  pagesVisited    Int      @default(0)
  errorCount      Int      @default(0)
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?
  urlSet          UrlSet?

  @@index([status])
  @@index([createdAt])
}

model UrlSet {
  id          String          @id @default(cuid())
  name        String?
  jobId       String?         @unique
  job         DiscoveryJob?   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  urls        DiscoveredUrl[]
  comparisons ComparisonJob[]
  createdAt   DateTime        @default(now())
}

model DiscoveredUrl {
  id       String  @id @default(cuid())
  urlSetId String
  url      String  // canonicalized form (shared-logic/canonicalize.ts)
  sources  String  // JSON array of contributing sources: ["crawl","sitemap","gsc","manual"]
  included Boolean @default(true)
  urlSet   UrlSet  @relation(fields: [urlSetId], references: [id], onDelete: Cascade)

  @@index([urlSetId])
  @@unique([urlSetId, url])
}

model ComparisonJob {
  id            String      @id @default(cuid())
  name          String?
  sourceUrls    String // JSON array — ad-hoc input or snapshot of urlSet's included URLs
  newDomain     String
  config        String // JSON configuration object
  status        String      @default("pending") // pending, running, completed, failed, cancelled
  totalUrls     Int         @default(0)
  completedUrls Int         @default(0)
  lastError     String?
  urlSetId      String?
  urlSet        UrlSet?     @relation(fields: [urlSetId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  urlResults    UrlResult[]
}

model UrlResult {
  id            String        @id @default(cuid())
  jobId         String
  sourceUrl     String
  newUrl        String
  statusCode    Int?
  redirectChain String? // JSON array of redirect URLs
  finalUrl      String?
  result        String // OK, Missing, Error, Redirected
  error         String?
  retryCount    Int           @default(0)
  checkedAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  job           ComparisonJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([result])
}

model OAuthCredential {
  id           String    @id @default(cuid())
  provider     String    @unique // "google"
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  scopes       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
