{
  "name": "shared-types",
  "private": true,
  "version": "0.1.0",
  "description": "Shared domain types and zod request schemas for urlCompare.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3"
  }
}
