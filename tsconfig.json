{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "shared-types": ["./packages/shared-types/src"],
      "shared-logic": ["./packages/shared-logic/src"],
      "shared-types/*": ["./packages/shared-types/src/*"],
      "shared-logic/*": ["./packages/shared-logic/src/*"]
    }
  }
}
