{
  "name": "urlcompare",
  "private": true,
  "version": "1.0.0",
  "description": "Compare URLs before deployment — web app, API server, and MCP server monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api-server",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run bundle --workspace=api-server",
    "lint:web": "npm run lint --workspace=web",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace=web",
    "test:api": "npm run test --workspace=api-server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
